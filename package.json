{
  "name": "tdx-taiwan-mcp",
  "version": "0.7.1",
  "description": "MCP server for Taiwan's TDX (Transport Data eXchange) API, built on the tdx-taiwan SDK — lets Claude and other MCP clients look up YouBike, bus ETAs, THSR/TRA/metro timetables and seats, flights, ferries, road traffic, parking and EV chargers, and query any TDX endpoint",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "tdx",
    "taiwan",
    "transport",
    "youbike",
    "bus",
    "thsr",
    "tra",
    "metro",
    "flight",
    "ferry",
    "traffic",
    "parking",
    "ev-charging",
    "claude"
  ],
  "mcpName": "io.github.amangeldievkuu/tdx-taiwan-mcp",
  "license": "MIT",
  "author": "Kutman",
  "homepage": "https://github.com/amangeldievkuu/tdx-taiwan-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amangeldievkuu/tdx-taiwan-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/amangeldievkuu/tdx-taiwan-mcp/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tdx-taiwan-mcp": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "start": "node dist/cli.js",
    "inspect": "npm run build && npx -y @modelcontextprotocol/inspector node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check:exports": "publint && attw --pack . --profile esm-only",
    "check:live": "npm run build && node scripts/live-check.mjs",
    "version": "node scripts/sync-version.mjs && git add src/version.ts server.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "tdx-taiwan": "^0.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
